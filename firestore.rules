rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isValidUserCreate() {
      return request.resource.data.keys().hasAll(['name', 'mobile', 'totalPoints', 'joinedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.mobile is string
        && request.resource.data.mobile.matches('^[0-9+\\-\\s]{10,15}$')
        && request.resource.data.totalPoints == 0
        && request.resource.data.joinedAt is timestamp;
    }

    function isValidMatchCreate() {
      return request.resource.data.keys().hasAll(['teamA', 'teamB', 'kickoffTime', 'status'])
        && request.resource.data.teamA is string
        && request.resource.data.teamB is string
        && request.resource.data.kickoffTime is timestamp
        && request.resource.data.status in ['upcoming', 'live', 'finished'];
    }

    function matchNotStarted(matchId) {
      return get(/databases/$(database)/documents/matches/$(matchId)).data.kickoffTime > request.time;
    }

    function matchIsUpcoming(matchId) {
      let match = get(/databases/$(database)/documents/matches/$(matchId)).data;
      return match.status == 'upcoming' && match.kickoffTime > request.time;
    }

    function isValidPredictionCreate() {
      let data = request.resource.data;
      let predId = data.userId + '_' + data.matchId;
      return request.resource.id == predId
        && data.keys().hasAll(['userId', 'matchId', 'scoreA', 'scoreB', 'predictedWinner', 'points', 'submittedAt'])
        && data.scoreA is int && data.scoreA >= 0 && data.scoreA <= 20
        && data.scoreB is int && data.scoreB >= 0 && data.scoreB <= 20
        && data.predictedWinner in ['teamA', 'teamB', 'draw']
        && data.points == 0
        && data.submittedAt is timestamp
        && exists(/databases/$(database)/documents/users/$(data.userId))
        && exists(/databases/$(database)/documents/matches/$(data.matchId))
        && matchIsUpcoming(data.matchId);
    }

    match /users/{userId} {
      allow read: if true;
      allow create: if isValidUserCreate();
      allow update: if isAdmin();
    }

    match /matches/{matchId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /predictions/{predictionId} {
      allow read: if true;
      allow create: if isValidPredictionCreate();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /mobiles/{mobile} {
      allow read: if false;
      allow create: if request.resource.data.keys().hasAll(['userId', 'createdAt'])
        && request.resource.data.userId is string
        && !exists(/databases/$(database)/documents/mobiles/$(mobile));
      allow update, delete: if isAdmin();
    }
  }
}
